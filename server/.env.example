PORT=5009
MONGO_URI=mongodb://127.0.0.1:27017/matinee

# No password:   redis://127.0.0.1:6379
# With password: redis://:YOUR_PASSWORD@127.0.0.1:6379  (URL-encode special characters)
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL=3600

# Where videos live on disk. Folders here == folders on the site.
MEDIA_ROOT=/var/media/matinee
# true when Nginx is in front (Nginx streams the files, Node only checks login)
USE_NGINX_ACCEL=false

# Login (single account: you)
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
JWT_SECRET=put-a-long-random-string-here

# false = login required to watch (recommended)
PUBLIC_BROWSING=false
# set true once HTTPS is on
COOKIE_SECURE=false

# Private folders: PIN needed to open them (you can also set/change it in Admin > Private folder PIN).
# Leave empty to manage it from Admin only.
PRIVATE_PIN=
# how long a correct PIN keeps private folders open (extends while you keep watching)
PRIVATE_UNLOCK_MINUTES=60
